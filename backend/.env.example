# AlgoLens AI Backend Configurations

# Database
# For Windows, make sure PostgreSQL is running and you have created 'algolens_db'
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/algolens_db

# Security
# JWT_SECRET MUST be a strong, unique random string in production. When
# ENVIRONMENT is not 'development' the server refuses to start with the
# built-in default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Abuse protection: in-process per-IP rate limiting on auth + AI endpoints.
# Keep on in production. Behind multiple workers the effective limit scales
# with worker count — add a proxy/gateway limit for a hard global cap.
RATE_LIMIT_ENABLED=true

# CORS: extra allowed origins (comma-separated), e.g. your deployed frontend.
# FRONTEND_URL is always allowed; localhost origins are auto-added in dev only.
CORS_ORIGINS=

# Password reset
# FRONTEND_URL is used to build the reset link sent to users (and is an
# allowed CORS origin). Set it to your real frontend URL in production.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=30
# 'development' logs reset links to the server console when SMTP is unset.
# Use 'production' (or any non-dev value) to enable the production config guard.
ENVIRONMENT=development

# SMTP email delivery (required for real reset emails).
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_16_char_app_password
# Optional: defaults to SMTP_USERNAME / "AlgoLens AI"
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AlgoLens AI
# Dev only: these recipient domains go to scratch/dev_outbox.json, not SMTP
EMAIL_DEV_OUTBOX_DOMAINS=test.dev

# AI Configuration (Google Gemini)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Problem import pipeline ---
# Max problems persisted per run (daily job + manual admin trigger).
PROBLEM_IMPORT_DAILY_LIMIT=10
# Generate original AI practice problems for under-covered topics (needs a key).
PROBLEM_IMPORT_AI_ENABLED=true
# Live LeetCode public-metadata source. Leave false unless you accept the legal
# trade-off of automated access; metadata-only (no statements/premium) when on.
PROBLEM_IMPORT_LEETCODE_ENABLED=false
